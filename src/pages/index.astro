---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout>
	<main class="flex min-h-screen flex-col items-center justify-center gap-4 px-6 text-center">
		<h1 class="font-display text-4xl text-space-text">Voyager</h1>
		<p class="text-space-muted">Tailwind + space palette wiring check.</p>
		<div class="flex gap-3">
			<span class="rounded border border-space-border bg-space-surface px-3 py-1 text-sm text-space-accent">accent</span>
			<span class="rounded border border-space-border bg-space-surface px-3 py-1 text-sm text-space-accent2">accent2</span>
		</div>
	</main>
</BaseLayout>
