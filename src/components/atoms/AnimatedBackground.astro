<canvas id="background-animation" class="fixed inset-0 -z-10 h-full w-full" aria-hidden="true"></canvas>
<script>
  import { getBackgroundAnimationController } from '../../config/background-animation-client';
  const canvas = document.getElementById('background-animation') as HTMLCanvasElement | null;
  if (canvas) {
    getBackgroundAnimationController(canvas).start();
  }
</script>
