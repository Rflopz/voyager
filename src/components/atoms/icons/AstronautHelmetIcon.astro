---
interface Props {
  class?: string;
}
const { class: className = 'h-5 w-5' } = Astro.props;
---
<svg
	xmlns="http://www.w3.org/2000/svg"
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.5"
	stroke-linecap="round"
	stroke-linejoin="round"
	class={className}
	aria-hidden="true"
>
	<!-- dome -->
	<path d="M4.5 12.5a7.5 7.5 0 0 1 15 0" />
	<!-- visor -->
	<path d="M4.5 12.5v1.3a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2v-1.3" fill="none" />
	<ellipse cx="12" cy="12.5" rx="4.6" ry="3.6" fill="currentColor" fill-opacity="0.18" stroke-width="1.3" />
	<!-- neck ring -->
	<path d="M8 17.4c0 1.3 1.8 2.3 4 2.3s4-1 4-2.3" />
	<!-- side antenna -->
	<path d="M18.6 9.4l1.9-.9" />
	<circle cx="20.9" cy="8.1" r="0.9" fill="currentColor" stroke="none" />
</svg>
