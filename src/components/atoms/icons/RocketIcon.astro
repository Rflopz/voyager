---
interface Props {
  class?: string;
}
const { class: className = 'h-5 w-5' } = Astro.props;
---
<svg
	xmlns="http://www.w3.org/2000/svg"
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.5"
	stroke-linecap="round"
	stroke-linejoin="round"
	class={className}
	aria-hidden="true"
>
	<!-- body -->
	<path
		d="M12 2.5c2.4 1.6 4 4.9 4 8.2 0 2.4-.6 4.4-1.3 5.9h-5.4C8.6 15.1 8 13.1 8 10.7c0-3.3 1.6-6.6 4-8.2Z"
		fill="currentColor"
		fill-opacity="0.16"
	/>
	<!-- nose window -->
	<circle cx="12" cy="9.5" r="1.6" />
	<!-- fins -->
	<path d="M8 13.5 5.2 16a2 2 0 0 0-.6 1.4V19l2.6-1.3a2 2 0 0 0 1-1.2L9 14.8" />
	<path d="M16 13.5 18.8 16a2 2 0 0 1 .6 1.4V19l-2.6-1.3a2 2 0 0 1-1-1.2L15 14.8" />
	<!-- exhaust -->
	<path d="M9.4 16.6c-.3 1.1-.4 2.5.2 3.9 1.3-.9 2-1.9 2.4-2.9" />
	<path d="M14.6 16.6c.3 1.1.4 2.5-.2 3.9-1.3-.9-2-1.9-2.4-2.9" />
</svg>
