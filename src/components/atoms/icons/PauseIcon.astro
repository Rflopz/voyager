---
interface Props {
  class?: string;
}
const { class: className = 'h-4 w-4' } = Astro.props;
---
<svg
	xmlns="http://www.w3.org/2000/svg"
	viewBox="0 0 24 24"
	fill="currentColor"
	class={className}
	aria-hidden="true"
	data-icon="pause"
>
	<rect x="6.5" y="5" width="4" height="14" rx="1" />
	<rect x="13.5" y="5" width="4" height="14" rx="1" />
</svg>
