---
import PlayIcon from './icons/PlayIcon.astro';
import PauseIcon from './icons/PauseIcon.astro';
---
<button
	type="button"
	id="animation-playpause-toggle"
	aria-pressed="false"
	aria-label="Pause background animation"
	class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-lg border border-space-border bg-space-surface/90 text-space-muted backdrop-blur transition-colors hover:text-space-text"
>
	<span class="block" data-state="playing"><PauseIcon /></span>
	<span class="hidden" data-state="paused"><PlayIcon /></span>
</button>
