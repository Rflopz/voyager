---
import GearIcon from './icons/GearIcon.astro';
interface Props {
  name: string;
  label: string;
  active: boolean;
}
const { name, label, active } = Astro.props;
---
<div class="animation-option-row flex items-center gap-1" data-animation-row={name}>
	<button
		type="button"
		data-animation-option={name}
		aria-pressed={active}
		class="min-w-0 flex-1 rounded px-3 py-1.5 text-left text-sm text-space-text transition-colors hover:bg-space-border/60 aria-pressed:text-space-accent"
	>
		{label}
	</button>
	<button
		type="button"
		data-animation-settings-trigger={name}
		aria-label={`${label} settings`}
		class="animation-option-row__gear shrink-0 rounded p-1.5 text-space-muted opacity-0 transition-opacity hover:bg-space-border/60 hover:text-space-text"
		hidden
	>
		<GearIcon class="h-3.5 w-3.5" />
	</button>
</div>
<style>
	/* Reveal the gear only for the row currently marked as configurable
	   (client script toggles the `hidden` attribute) and only on hover of
	   that row, so the list stays visually calm when not interacted with. */
	.animation-option-row:hover .animation-option-row__gear {
		opacity: 1;
	}
</style>
