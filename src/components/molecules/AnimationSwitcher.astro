---
import AnimationOptionButton from '../atoms/AnimationOptionButton.astro';
import RocketIcon from '../atoms/icons/RocketIcon.astro';
import AnimationSettingsPanel from './AnimationSettingsPanel.astro';
import { listAnimations } from '../../infrastructure/animations/registry';
import { ACTIVE_BACKGROUND_ANIMATION } from '../../config/site';

const animations = listAnimations();
---
<div class="animation-switcher group relative">
	<button
		type="button"
		aria-haspopup="true"
		aria-expanded="false"
		aria-label="Change background animation"
		id="animation-switcher-trigger"
		class="animation-switcher__trigger flex h-9 w-9 cursor-pointer items-center justify-center rounded-lg border border-space-border bg-space-surface/90 text-space-muted backdrop-blur transition-colors hover:text-space-text"
	>
		<RocketIcon class="h-4 w-4 shrink-0" />
	</button>
	<div id="animation-switcher-menu" role="menu" class="animation-switcher__menu absolute right-0 top-full w-44">
		<div class="animation-switcher__menu-inner rounded-bl-lg rounded-br-lg rounded-tl-lg border border-t-0 border-space-border bg-space-surface/90 p-1 backdrop-blur">
			{animations.map((a) => (
				<AnimationOptionButton name={a.name} label={a.label} active={a.name === ACTIVE_BACKGROUND_ANIMATION} />
			))}
		</div>
		<AnimationSettingsPanel />
	</div>
</div>
<script>
	import { getBackgroundAnimationController } from '../../config/background-animation-client';

	const container = document.getElementById('background-animation-container');
	const menu = document.getElementById('animation-switcher-menu');
	const playPauseButton = document.getElementById('animation-playpause-toggle');
	const settingsPanel = document.getElementById('animation-settings-panel');
	const settingRowTemplate = document.getElementById('animation-setting-row-template') as HTMLTemplateElement | null;

	if (container && menu) {
		const controller = getBackgroundAnimationController(container);

		const optionButtons = menu.querySelectorAll<HTMLButtonElement>('[data-animation-option]');
		const gearButtons = menu.querySelectorAll<HTMLButtonElement>('[data-animation-settings-trigger]');

		const syncActiveState = () => {
			const current = controller.getCurrent();
			optionButtons.forEach((btn) => {
				btn.setAttribute('aria-pressed', String(btn.dataset.animationOption === current));
			});
			// Only the currently mounted animation can be configured live —
			// show its gear, hide the others (a not-yet-mounted adapter has
			// no in-memory state for the panel to read/write anyway).
			gearButtons.forEach((btn) => {
				const isCurrent = btn.dataset.animationSettingsTrigger === current;
				const hasSettings = isCurrent && controller.getSettingsSchema().length > 0;
				btn.hidden = !hasSettings;
			});
		};

		optionButtons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const name = btn.dataset.animationOption;
				if (!name) return;
				controller.switchTo(name as Parameters<typeof controller.switchTo>[0]);
				closeSettingsPanel();
				syncActiveState();
			});
		});

		function closeSettingsPanel() {
			settingsPanel?.classList.add('hidden');
			if (settingsPanel) settingsPanel.innerHTML = '';
		}

		function openSettingsPanel() {
			if (!settingsPanel || !settingRowTemplate) return;
			settingsPanel.innerHTML = '';
			const schema = controller.getSettingsSchema();
			for (const param of schema) {
				const row = settingRowTemplate.content.cloneNode(true) as DocumentFragment;
				const labelEl = row.querySelector<HTMLElement>('[data-setting-label]');
				const valueEl = row.querySelector<HTMLElement>('[data-setting-value]');
				const inputEl = row.querySelector<HTMLInputElement>('[data-setting-input]');
				if (!labelEl || !valueEl || !inputEl) continue;

				labelEl.textContent = param.label;
				inputEl.min = String(param.min);
				inputEl.max = String(param.max);
				inputEl.step = String(param.step);
				const current = controller.getSetting(param.key);
				inputEl.value = String(current);
				valueEl.textContent = current.toFixed(2);

				inputEl.addEventListener('input', () => {
					const value = Number(inputEl.value);
					controller.setSetting(param.key, value);
					valueEl.textContent = value.toFixed(2);
				});

				settingsPanel.appendChild(row);
			}
			settingsPanel.classList.remove('hidden');
		}

		gearButtons.forEach((btn) => {
			btn.addEventListener('click', (event) => {
				event.stopPropagation();
				const isOpen = settingsPanel && !settingsPanel.classList.contains('hidden');
				if (isOpen) {
					closeSettingsPanel();
				} else {
					openSettingsPanel();
				}
			});
		});

		syncActiveState();

		if (playPauseButton) {
			const playingIcon = playPauseButton.querySelector<HTMLElement>('[data-state="playing"]');
			const pausedIcon = playPauseButton.querySelector<HTMLElement>('[data-state="paused"]');

			const syncPlayState = () => {
				const playing = controller.isPlaying();
				playPauseButton.setAttribute('aria-pressed', String(!playing));
				playPauseButton.setAttribute('aria-label', playing ? 'Pause background animation' : 'Play background animation');
				playingIcon?.classList.toggle('hidden', !playing);
				pausedIcon?.classList.toggle('hidden', playing);
			};

			playPauseButton.addEventListener('click', () => {
				controller.togglePlayback();
				syncPlayState();
			});

			syncPlayState();
		}
	}
</script>
<style>
	/*
	 * The trigger button keeps a fixed h-9 w-9 footprint at all times —
	 * it never resizes when the menu opens. The menu is an absolutely
	 * positioned dropdown (out of normal flow), right-aligned under the
	 * button with zero gap (top: 100%), so growing it never pushes the
	 * button or the play/pause button beside it.
	 *
	 * To read as ONE continuous shape instead of two stacked boxes: the
	 * button has no bottom border while the menu is open (group-hover
	 * toggles it to transparent) and the menu itself has no top border at
	 * all — same background/blur on both — so the seam between them is
	 * invisible. Button bottom corners square off on open so the shape's
	 * outline continues cleanly into the menu's rounded bottom corners.
	 */
	.animation-switcher__trigger {
		transition:
			color 150ms ease,
			border-color 150ms ease,
			border-radius 150ms ease;
	}

	.animation-switcher.group:hover .animation-switcher__trigger,
	.animation-switcher.group:focus-within .animation-switcher__trigger {
		border-bottom-color: transparent;
		border-bottom-left-radius: 0;
		border-bottom-right-radius: 0;
	}

	.animation-switcher__menu {
		display: grid;
		grid-template-rows: 0fr;
		opacity: 0;
		pointer-events: none;
		transition:
			grid-template-rows 220ms ease,
			opacity 160ms ease;
	}

	.animation-switcher.group:hover .animation-switcher__menu,
	.animation-switcher.group:focus-within .animation-switcher__menu {
		grid-template-rows: 1fr;
		opacity: 1;
		pointer-events: auto;
	}

	.animation-switcher__menu-inner {
		position: relative;
		overflow: hidden;
		min-height: 0;
	}

	/*
	 * Draws the rounded top-left corner + a top border for the segment of
	 * the menu's top edge that is NOT directly under the trigger button
	 * (width = 100% - button width). The segment under the button (the
	 * remaining 2.25rem on the right) gets no border/corner here — that's
	 * exactly the part that should stay "open" and flush with the button
	 * above it, closing the whole shape into one continuous outline.
	 */
	.animation-switcher__menu-inner::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: calc(100% - 2.25rem); /* 2.25rem = trigger button width (h-9 w-9) */
		height: 0.5rem; /* matches rounded-lg radius so the curve completes */
		border-top: 1px solid var(--color-space-border);
		border-left: 1px solid var(--color-space-border);
		border-top-left-radius: 0.5rem;
		pointer-events: none;
	}
</style>
