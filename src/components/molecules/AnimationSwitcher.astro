---
import AnimationOptionButton from '../atoms/AnimationOptionButton.astro';
import PlayPauseButton from '../atoms/PlayPauseButton.astro';
import RocketIcon from '../atoms/icons/RocketIcon.astro';
import { listAnimations } from '../../infrastructure/animations/registry';
import { ACTIVE_BACKGROUND_ANIMATION } from '../../config/site';

const animations = listAnimations();
---
<div class="fixed right-6 top-6 z-10 flex items-start gap-2">
	<div class="animation-switcher group relative">
		<button
			type="button"
			aria-haspopup="true"
			aria-expanded="false"
			aria-label="Change background animation"
			id="animation-switcher-trigger"
			class="animation-switcher__trigger flex h-9 w-9 items-center justify-center rounded-lg border border-space-border bg-space-surface/90 text-space-muted backdrop-blur transition-colors hover:text-space-text"
		>
			<RocketIcon class="h-4 w-4 shrink-0" />
		</button>
		<div id="animation-switcher-menu" role="menu" class="animation-switcher__menu absolute right-0 top-full w-44">
			<div class="animation-switcher__menu-inner rounded-b-lg border border-t-0 border-space-border bg-space-surface/90 p-1 backdrop-blur">
				{animations.map((a) => (
					<AnimationOptionButton name={a.name} label={a.label} active={a.name === ACTIVE_BACKGROUND_ANIMATION} />
				))}
			</div>
		</div>
	</div>
	<PlayPauseButton />
</div>
<script>
	import { getBackgroundAnimationController } from '../../config/background-animation-client';

	const canvas = document.getElementById('background-animation') as HTMLCanvasElement | null;
	const menu = document.getElementById('animation-switcher-menu');
	const playPauseButton = document.getElementById('animation-playpause-toggle');

	if (canvas && menu) {
		const controller = getBackgroundAnimationController(canvas);

		const optionButtons = menu.querySelectorAll<HTMLButtonElement>('[data-animation-option]');
		const syncActiveState = () => {
			const current = controller.getCurrent();
			optionButtons.forEach((btn) => {
				btn.setAttribute('aria-pressed', String(btn.dataset.animationOption === current));
			});
		};

		optionButtons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const name = btn.dataset.animationOption;
				if (!name) return;
				controller.switchTo(name as Parameters<typeof controller.switchTo>[0]);
				syncActiveState();
			});
		});

		syncActiveState();

		if (playPauseButton) {
			const playingIcon = playPauseButton.querySelector<HTMLElement>('[data-state="playing"]');
			const pausedIcon = playPauseButton.querySelector<HTMLElement>('[data-state="paused"]');

			const syncPlayState = () => {
				const playing = controller.isPlaying();
				playPauseButton.setAttribute('aria-pressed', String(!playing));
				playPauseButton.setAttribute('aria-label', playing ? 'Pause background animation' : 'Play background animation');
				playingIcon?.classList.toggle('hidden', !playing);
				pausedIcon?.classList.toggle('hidden', playing);
			};

			playPauseButton.addEventListener('click', () => {
				controller.togglePlayback();
				syncPlayState();
			});

			syncPlayState();
		}
	}
</script>
<style>
	/*
	 * The trigger button keeps a fixed h-9 w-9 footprint at all times —
	 * it never resizes when the menu opens. The menu is an absolutely
	 * positioned dropdown (out of normal flow), right-aligned under the
	 * button with zero gap (top: 100%), so growing it never pushes the
	 * button or the play/pause button beside it.
	 *
	 * To read as ONE continuous shape instead of two stacked boxes: the
	 * button has no bottom border while the menu is open (group-hover
	 * toggles it to transparent) and the menu itself has no top border at
	 * all — same background/blur on both — so the seam between them is
	 * invisible. Button bottom corners square off on open so the shape's
	 * outline continues cleanly into the menu's rounded bottom corners.
	 */
	.animation-switcher__trigger {
		transition:
			color 150ms ease,
			border-color 150ms ease,
			border-radius 150ms ease;
	}

	.animation-switcher.group:hover .animation-switcher__trigger,
	.animation-switcher.group:focus-within .animation-switcher__trigger {
		border-bottom-color: transparent;
		border-bottom-left-radius: 0;
		border-bottom-right-radius: 0;
	}

	.animation-switcher__menu {
		display: grid;
		grid-template-rows: 0fr;
		opacity: 0;
		pointer-events: none;
		transition:
			grid-template-rows 220ms ease,
			opacity 160ms ease;
	}

	.animation-switcher.group:hover .animation-switcher__menu,
	.animation-switcher.group:focus-within .animation-switcher__menu {
		grid-template-rows: 1fr;
		opacity: 1;
		pointer-events: auto;
	}

	.animation-switcher__menu-inner {
		overflow: hidden;
		min-height: 0;
	}
</style>
