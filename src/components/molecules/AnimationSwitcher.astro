---
import AnimationOptionButton from '../atoms/AnimationOptionButton.astro';
import PlayPauseButton from '../atoms/PlayPauseButton.astro';
import RocketIcon from '../atoms/icons/RocketIcon.astro';
import { listAnimations } from '../../infrastructure/animations/registry';
import { ACTIVE_BACKGROUND_ANIMATION } from '../../config/site';

const animations = listAnimations();
---
<div class="fixed right-6 top-6 z-10 flex items-start gap-2">
	<div class="animation-switcher overflow-hidden rounded-lg border border-space-border bg-space-surface/90 backdrop-blur">
		<button
			type="button"
			aria-haspopup="true"
			aria-expanded="false"
			aria-label="Change background animation"
			id="animation-switcher-trigger"
			class="flex h-9 w-9 items-center justify-center text-space-muted transition-colors hover:text-space-text"
		>
			<RocketIcon class="h-5 w-5 shrink-0" />
		</button>
		<div id="animation-switcher-menu" role="menu" class="animation-switcher__menu">
			<div class="animation-switcher__menu-inner w-44 border-t border-space-border/70 p-1">
				{animations.map((a) => (
					<AnimationOptionButton name={a.name} label={a.label} active={a.name === ACTIVE_BACKGROUND_ANIMATION} />
				))}
			</div>
		</div>
	</div>
	<PlayPauseButton />
</div>
<script>
	import { getBackgroundAnimationController } from '../../config/background-animation-client';

	const canvas = document.getElementById('background-animation') as HTMLCanvasElement | null;
	const menu = document.getElementById('animation-switcher-menu');
	const playPauseButton = document.getElementById('animation-playpause-toggle');

	if (canvas && menu) {
		const controller = getBackgroundAnimationController(canvas);

		const optionButtons = menu.querySelectorAll<HTMLButtonElement>('[data-animation-option]');
		const syncActiveState = () => {
			const current = controller.getCurrent();
			optionButtons.forEach((btn) => {
				btn.setAttribute('aria-pressed', String(btn.dataset.animationOption === current));
			});
		};

		optionButtons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const name = btn.dataset.animationOption;
				if (!name) return;
				controller.switchTo(name as Parameters<typeof controller.switchTo>[0]);
				syncActiveState();
			});
		});

		syncActiveState();

		if (playPauseButton) {
			const playingIcon = playPauseButton.querySelector<HTMLElement>('[data-state="playing"]');
			const pausedIcon = playPauseButton.querySelector<HTMLElement>('[data-state="paused"]');

			const syncPlayState = () => {
				const playing = controller.isPlaying();
				playPauseButton.setAttribute('aria-pressed', String(!playing));
				playPauseButton.setAttribute('aria-label', playing ? 'Pause background animation' : 'Play background animation');
				playingIcon?.classList.toggle('hidden', !playing);
				pausedIcon?.classList.toggle('hidden', playing);
			};

			playPauseButton.addEventListener('click', () => {
				controller.togglePlayback();
				syncPlayState();
			});

			syncPlayState();
		}
	}
</script>
<style>
	/*
	 * Trigger + menu are ONE bordered/rounded shape (.animation-switcher),
	 * not two separate elements — the menu sits directly under the button
	 * inside the same box, so there's no gap for the pointer to "fall out
	 * of" moving from button to menu. That's what keeps the menu open on
	 * hover instead of requiring a click to keep it pinned.
	 *
	 * Width AND height both grow on hover: width via max-width transition
	 * (animatable because both endpoints are fixed values, unlike "auto"),
	 * height via a 0fr -> 1fr grid-template-rows transition (the only way
	 * to animate toward an intrinsic/auto height in CSS).
	 */
	.animation-switcher {
		max-width: 2.25rem; /* matches h-9 w-9 trigger button */
		transition: max-width 260ms ease;
	}

	.animation-switcher:hover,
	.animation-switcher:focus-within {
		max-width: 11rem; /* matches menu-inner's w-44 */
	}

	.animation-switcher__menu {
		display: grid;
		grid-template-rows: 0fr;
		opacity: 0;
		transition:
			grid-template-rows 220ms ease 40ms,
			opacity 160ms ease 40ms;
	}

	.animation-switcher:hover .animation-switcher__menu,
	.animation-switcher:focus-within .animation-switcher__menu {
		grid-template-rows: 1fr;
		opacity: 1;
	}

	.animation-switcher__menu-inner {
		overflow: hidden;
		min-height: 0;
	}
</style>
