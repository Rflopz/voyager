---
import SectionIndex from '../atoms/SectionIndex.astro';
import { formatYearRange } from '../../application/format-cv-dates';
import type { ExperienceEntry } from '../../domain/cv/cv';

interface Props {
  experience: ExperienceEntry[];
}
const { experience } = Astro.props;
---
<section
  id="experience"
  aria-labelledby="exp-h"
  class="mt-[18vh] grid grid-cols-[clamp(58px,9vw,96px)_minmax(0,1fr)] items-start"
>
  <SectionIndex index="004" />
  <div>
    <h2
      id="exp-h"
      data-i18n="secExp"
      class="m-0 font-mono text-[11px] font-normal uppercase leading-[1.75] tracking-[0.18em] text-space-muted"
    >
      EXPERIENCE
    </h2>
    <div class="mt-14 flex flex-col">
      {
        experience.map((entry, i) => {
          const stack = entry.summary
            ? entry.summary
                .split(',')
                .map((tech) => tech.trim())
                .filter(Boolean)
            : [];

          return (
            <article class="group relative -mx-[22px] grid grid-cols-1 gap-3 border-t border-space-border px-[22px] py-[38px] transition-colors duration-700 hover:bg-space-surface last:border-b md:grid-cols-[minmax(0,180px)_minmax(0,1fr)] md:gap-7">
              <span
                aria-hidden="true"
                class="absolute -top-px left-0 h-px w-full origin-left scale-x-0 bg-space-accent transition-transform duration-500 group-hover:scale-x-100"
              />
              <div class="flex flex-col gap-[10px] font-mono text-[11px] uppercase tracking-[0.18em] text-space-muted">
                {i === 0 && <span class="text-space-accent opacity-90">CURRENT</span>}
                <span class="opacity-60">{formatYearRange(entry.start_date, entry.end_date)}</span>
                {entry.location && <span class="opacity-40 normal-case tracking-normal">{entry.location}</span>}
              </div>
              <div class="transition-transform duration-700 group-hover:translate-x-[6px]">
                <h3 class="m-0 font-display text-[24px] font-normal leading-[1.2] tracking-[-0.01em] text-space-text">
                  {entry.company}
                </h3>
                <p class="m-0 mt-1 font-mono text-[11px] uppercase tracking-[0.18em] text-space-muted opacity-60">
                  {entry.position}
                </p>
                {stack.length > 0 && (
                  <div class="mt-4 flex flex-wrap gap-2">
                    {stack.map((tech) => (
                      <span class="rounded-full border border-space-border px-[10px] py-[3px] font-mono text-[10px] uppercase tracking-[0.1em] text-space-muted">
                        {tech}
                      </span>
                    ))}
                  </div>
                )}
                {entry.highlights.length > 0 && (
                  <ul class="mt-5 flex max-w-[62ch] flex-col gap-[10px] p-0" style="list-style: none;">
                    {entry.highlights.map((highlight) => (
                      <li class="flex gap-3 text-[15px] leading-[1.75] text-space-muted text-pretty">
                        <span aria-hidden="true" class="mt-[10px] h-1 w-1 shrink-0 rounded-full bg-space-accent opacity-70" />
                        {highlight}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
